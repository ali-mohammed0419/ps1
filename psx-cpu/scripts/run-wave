#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
TESTBENCH_SPEC="${1:-}"

if [[ $# -ne 1 || -z "$TESTBENCH_SPEC" ]]; then
    echo "usage: $0 <testbench.sv>" >&2
    echo "example: $0 tests/cpu/cpu_add.sv" >&2
    exit 1
fi

if [[ "$TESTBENCH_SPEC" != *.sv ]]; then
    echo "error: testbench must be a SystemVerilog file (*.sv)" >&2
    exit 1
fi

TESTBENCH="$ROOT_DIR/$TESTBENCH_SPEC"
TEST_MODULE="$(basename "$TESTBENCH" .sv)"

if [[ ! -f "$TESTBENCH" ]]; then
    echo "error: expected testbench $TESTBENCH" >&2
    exit 1
fi

if [[ ! "$TEST_MODULE" =~ ^[A-Za-z_][A-Za-z0-9_]*$ ]]; then
    echo "error: testbench filename must be a valid SystemVerilog module name" >&2
    exit 1
fi

if ! command -v surfer >/dev/null 2>&1; then
    echo "error: surfer is not installed or not on PATH" >&2
    exit 1
fi

BUILD_KEY="${TESTBENCH_SPEC%.sv}"
BUILD_KEY="${BUILD_KEY//\//__}"
BUILD_DIR="$ROOT_DIR/obj_dir/sv__${BUILD_KEY}_wave"
SIM_BINARY="$BUILD_DIR/V${TEST_MODULE}"
WAVE_DIR="$ROOT_DIR/waves"
WAVE_FILE="$WAVE_DIR/${BUILD_KEY}.vcd"

RTL_SOURCES=("$ROOT_DIR/rtl/mips_defs.sv")
for file in "$ROOT_DIR"/rtl/*.sv; do
    [[ "$file" == "$ROOT_DIR/rtl/mips_defs.sv" ]] && continue
    RTL_SOURCES+=("$file")
done

mkdir -p "$BUILD_DIR" "$WAVE_DIR"

verilator \
    --binary \
    --timing \
    --trace \
    --timescale-override 1ns/1ps \
    --Wno-fatal \
    --top-module "$TEST_MODULE" \
    --Mdir "$BUILD_DIR" \
    "${RTL_SOURCES[@]}" \
    "$TESTBENCH"

(cd "$ROOT_DIR" && "$SIM_BINARY" "+WAVE_FILE=$WAVE_FILE")

surfer "$WAVE_FILE"
